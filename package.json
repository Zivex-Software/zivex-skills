    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
