{
  "name": "zivex-skills",
  "version": "0.0.0",
  "description": "Install AI-agent skills, rules, hooks and subagents for .NET modular-monolith development into Claude Code, Cursor and Codex.",
  "keywords": [
    "agent-skills",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "dotnet"
  ],
  "homepage": "https://github.com/zivex-software/zivex-skills#readme",
  "bugs": {
    "url": "https://github.com/zivex-software/zivex-skills/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zivex-software/zivex-skills.git"
  },
  "bin": {
    "zivex-skills": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "content"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
